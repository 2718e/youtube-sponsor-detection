# Which model answers the questions. Anything that speaks the System One
# protocol works, hosted or local:
#
#   hosted Jev     MODEL_URL=https://api.typesafe.ai   MODEL_API_KEY=<key>
#   local server   MODEL_URL=http://127.0.0.1:8009     (no key needed)
#
MODEL_URL=https://api.typesafe.ai
MODEL_API_KEY=
# MODEL_PROTOCOL=systemone
# MODEL_NAME=jev-latest

# Optional
# PORT=3000
