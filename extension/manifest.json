{
  "manifest_version": 3,
  "name": "Sponsor Skip",
  "version": "0.2.0",
  "description": "Finds the sponsor read in a YouTube video with a typed-question model and skips it. Works with hosted Jev or a local Jev-compatible server.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.typesafe.ai/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Sponsor Skip" },
  "icons": { "128": "icons/icon128.png" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["page-bridge.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["panel.css"],
      "run_at": "document_idle"
    }
  ]
}
